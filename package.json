{
  "name": "bluetang",
  "version": "0.4.1",
  "description": "Proxy intelligent entre client LLM et Ollama — RAG + mémoire + client MCP",
  "author": "OnyxynO <etievant.sebastien@protonmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnyxynO/BlueTang.git"
  },
  "homepage": "https://github.com/OnyxynO/BlueTang#readme",
  "keywords": [
    "llm",
    "ollama",
    "rag",
    "mcp",
    "proxy",
    "local-ai",
    "continue"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "bluetang": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --clean",
    "pretest": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@inquirer/prompts": "^8.7.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "hono": "^4.13.13",
    "ignore": "^7.0.12",
    "sqlite-vec": "^0.1.9",
    "tree-sitter": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "tree-sitter",
    "tree-sitter-javascript",
    "tree-sitter-php",
    "tree-sitter-python",
    "tree-sitter-typescript"
  ]
}
